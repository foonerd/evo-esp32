# Rust std needs more than the default main task stack. The decoder runs
# on the main task; the heartbeat reports its low-water mark, which a day
# of FLAC, WAV and MP3 at 44.1 and 96 kHz left above 40 KB of 48, so 32
# keeps a threefold margin and gives 16 KB of internal SRAM back.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# The board's flash is 32 MB and the C5's MMU reaches all of it (512
# pages of 64 KB). partitions.csv lays it out (one 8 MB app for now);
# scripts/image.sh generates the table from it, as esp-idf-sys does not
# pass a crate's CSV to the ESP-IDF build. The stock table named here is
# a stand-in for that build only.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Board has 8 MB PSRAM, and the player leans on it: the album art, the
# decoder's buffers, and the Wi-Fi driver's and LwIP's pools go there.
# A board without PSRAM therefore panics at init (the log says so)
# rather than running out of internal RAM later; IGNORE_NOTFOUND would
# also switch the Wi-Fi/LwIP-in-PSRAM option off.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Internal SRAM is the scarce memory on the C5 (code in IRAM and data
# share it). The Wi-Fi driver's IRAM optimisations default on and cost
# tens of kilobytes of it for throughput a music stream does not need;
# the code runs from flash instead. Static RX buffers are DMA memory and
# stay internal (1.6 KB each); Espressif's floor for a PSRAM-first
# build is 16, and 12 is what the SRAM budget allows beside an MP3
# decoder (R45): the six of 0.1.5 could not take a 64 KB NFS reply
# without drops. The dynamic ones are in PSRAM and must cover a full
# receive window in frames (65535 / 1460 = 45) or the driver drops
# what lwIP has not yet queued.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
# The block-ack window may not exceed twice the static buffers.
CONFIG_ESP_WIFI_RX_BA_WIN=12
# A player receives; it sends acknowledgements and requests. With the
# pools in PSRAM the TX buffers are static (the only type allowed) and
# the cache buffers are the internal copies the MAC sends from.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3

# A stream over TCP gets at most one receive window per round trip. The
# default window of four segments (5.7 KB) caps a Wi-Fi link whose round
# trip wanders at a few tens of kilobytes a second. A NAS answers in
# 25–75 ms over this radio: with 32 KB one connection carried at most
# ~640 KB/s; 64 KB is the largest without window scaling. The segments
# wait in PSRAM (the dynamic RX buffers above, enough for a full
# window), the socket's mailbox holds a window's worth of them, and so
# must the tcpip task's own mailbox, which every received frame passes
# through first: a frame it cannot take is freed without a word
# (wlanif_input → tcpip_inpkt → sys_mbox_trypost), and at its default
# of 32 the tail of every 45-segment reply was lost and resent after
# the server's timer.
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# lwIP's retransmission timer: the initial RTO is also its floor (the
# variance term starts at RTO/500 ms ticks and `3 >> 2 == 0` never
# lets it decay), and the back-off shifts it by 2, 3, 4 bits. At the
# 1500 ms default a lost request was sent again at 1.5 s, 7.5 s and
# 19.5 s — a 20 s RPC timeout fired right after the third. At 500 ms:
# 0.5 s, 2.5 s, 6.5 s. A NAS acknowledges within 200 ms and answers
# within 75 ms, so 500 ms does not retransmit what is merely slow.
# Selective acknowledgements let the server resend the one lost
# segment of a 45-segment reply instead of everything after it.
CONFIG_LWIP_TCP_RTO_TIME=500
CONFIG_LWIP_TCP_SACK_OUT=y

# Sockets at once: the Snapcast stream, the Evo room's listener, the
# station or art fetch, mDNS, and the Volumio presence (a listener, a
# held poll per Volumio connected, a poll per Volumio heard, and their
# short posts). The default ten runs out with two Volumio devices.
CONFIG_LWIP_MAX_SOCKETS=16

# TLS for https:// streams: mbedTLS takes tens of kilobytes for a
# session (its 16 KB record buffers above all); in PSRAM, where the
# stream's own buffer is. The default bundle of root certificates stays.
# AES in software: the hardware AES path copies a record held in PSRAM
# through DMA-capable internal buffers it allocates per call, and when
# internal SRAM is briefly short (a logo arriving as the station starts)
# that allocation fails and the TLS read with it, which mbedTLS treats
# as fatal - seen on the bench as a station dying ten seconds in. A
# stream is kilobytes a second; software AES is a few percent of a core.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_HARDWARE_AES=n

# The card: long file names (the default is 8.3 only), buffers on the heap,
# and names handed to the application as UTF-8 (the default is the OEM code
# page, which Rust strings cannot hold). Fast seek: a file opened for
# reading gets a map of its clusters at the open, so a seek into it is
# arithmetic rather than a walk of the FAT chain from the file's start
# (a FLAC seek probes several places); a file in more fragments than
# the map holds falls back to the walk by itself. The map is 2 KB per
# open file, room for 255 fragments: the default of 64 words (31
# fragments) failed on every file of a well-used card.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=512

# The console on the USB Serial/JTAG port the board is programmed through,
# so UART0's pins (GPIO11, GPIO12 on J6) are free for the HAT's I2S data.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# A 1 ms scheduler tick. Below one tick, ESP-IDF's usleep() spins instead
# of yielding, so at the default 100 Hz every sleep under 10 ms starves the
# idle task and its watchdog bites. The decoder is paced in milliseconds.
CONFIG_FREERTOS_HZ=1000

# The mDNS responder (the device's .local name and the Evo service) runs
# its task and keeps its records in PSRAM: it never runs with the flash
# cache off, and internal SRAM is for the Wi-Fi driver and the DMA.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# Who had the core: the kernel keeps a run-time counter per task (the
# high-resolution timer, read at each switch) and the heartbeat reports
# each task's share of the last period. The cost is a timer read per
# context switch.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# The task watchdog watches the loop and the feeder, which subscribe to
# it and reset it each turn, rather than the idle task. The player runs
# above idle by design: an HE-AAC station has the decoder at four fifths
# of the core and a station's logo decodes beneath it on the art thread,
# and the idle task not running for five seconds is then the schedule
# working, not a fault (it fired at every BBC station's open). The loop
# not turning for five seconds is.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

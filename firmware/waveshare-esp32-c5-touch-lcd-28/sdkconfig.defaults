# Rust std needs more than the default main task stack.
# The decoder runs on the main task; the heartbeat reports its low-water mark.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=49152
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Board has 32 MB flash. Declaring 4 MB is deliberate for a bring-up image:
# smaller than actual is safe, and avoids >16 MB addressing questions.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Board has 8 MB PSRAM. Probe it, but keep booting if init fails so the
# log reports the result instead of a boot loop.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# The card: long file names (the default is 8.3 only), buffers on the heap,
# and names handed to the application as UTF-8 (the default is the OEM code
# page, which Rust strings cannot hold).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# The console on the USB Serial/JTAG port the board is programmed through,
# so UART0's pins (GPIO11, GPIO12 on J6) are free for the HAT's I2S data.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# A 1 ms scheduler tick. Below one tick, ESP-IDF's usleep() spins instead
# of yielding, so at the default 100 Hz every sleep under 10 ms starves the
# idle task and its watchdog bites. The decoder is paced in milliseconds.
CONFIG_FREERTOS_HZ=1000
